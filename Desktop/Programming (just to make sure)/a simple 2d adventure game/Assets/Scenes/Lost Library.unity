    \u0434\u0432\u0435\u0440\u0438 \u0438 \u043A\u043E\u0434 \u0447\u0442\u043E\u0431
    \u043F\u0435\u0440\u0441 \u043C\u0435\u0436\u0434\u0443 \u0434\u0432\u0435\u0440\u044F\u043C\u0438
    \u0445\u043E\u0434\u0438\u043B\u044E \u043D\u0443 \u0438 \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435.
    \u0430 \u043D\u0443 \u0438 \u0435\u0449\u0435 \u0447\u0442\u043E\u0431 \u043C\u043E\u0433\u043B\u0438
    \u043D\u0430 \u0437\u043D\u0430\u043A\u0438 \u043D\u0430\u0436\u0438\u043C\u0430\u0442\u044C
    \u043D\u0430 E \u0441\u0434\u0435\u043B\u0430\u0439\n"
