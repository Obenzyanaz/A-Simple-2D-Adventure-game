  m_text: "\u0434\u043E\u0431\u0430\u0432\u044C \u0441\u0432\u0435\u0442 \u0438 \u0441\u0434\u0435\u043B\u0430\u0439
    \u043A\u0430\u043C\u0435\u0440\u0443 \u043C\u0435\u043D\u044C\u0448\u0435 \u0438
    \u0434\u0438\u0430\u043B\u043E\u0433 \u044E\u043A\u0430\u0440\u0438 \u0433\u0434\u0435
    \u043E\u043D\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E \u0440\u044B\u0446\u0430\u0440\u0435,
